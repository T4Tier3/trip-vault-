# Copy to .env and adjust. Expo inlines EXPO_PUBLIC_* variables when Metro
# builds the bundle, so no rebuild step is needed after editing this.

# Where the Go API is reachable from the device running the app.
#
#   iOS simulator / Android emulator: http://localhost:8080
#   Physical device on the same Wi-Fi: http://<this-machine-lan-ip>:8080
#
# `localhost` on a phone means the phone itself, which is why the app reports
# "Could not reach TripVault" until this is set to the LAN address.
# Find it with: ipconfig getifaddr en0
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080
