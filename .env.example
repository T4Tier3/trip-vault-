# ---------------------------------------------------------------------------
# TripVault - local development environment
# Copy to .env and fill in values.  NEVER commit the real .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---------------------------- Application ----------------------------------
APP_ENV=development
PORT=8080
APP_NAME=TripVault
# Public base URL of this API, used to identify the service in email and logs.
APP_BASE_URL=http://localhost:8080
# Custom URL scheme the mobile app registers. Email links use this so tapping one
# opens the app, for example: tripvault://reset-password?token=...
# Must match the scheme in the app's native config, or links will not open it.
APP_LINK_SCHEME=tripvault
# Comma-separated browser origins allowed to call the API. Empty is correct for a
# mobile-only client, which sends no Origin header.
ALLOWED_ORIGINS=

# ---------------------------- Database ------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripvault?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h

# ---------------------------- Redis ----------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ---------------------------- JWT ------------------------------------------
# Generate with:  openssl rand -base64 48
# MUST be different from each other and at least 32 bytes long.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_ISSUER=tripvault-api
JWT_REFRESH_ISSUER=tripvault-api
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=720h

# ---------------------------- Argon2id ------------------------------------
# Cost parameters. Raise for production, lower for fast local test runs.
ARGON2_TIME=3
ARGON2_MEMORY_KIB=65536
ARGON2_THREADS=2

# ---------------------------- Email (Mailpit locally) ----------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# Keep SMTP_FROM a bare address. Angle brackets would need quoting to survive
# shell sourcing, and the display name is added by the mailer.
SMTP_FROM=no-reply@tripvault.local
SMTP_TLS=false

# ---------------------------- ImageKit ------------------------------------
# The PRIVATE KEY must only ever live here, on the backend.
# It must NEVER be shipped inside the mobile application.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---------------------------- Push Notifications --------------------------
FCM_PROJECT_ID=

# ---------------------------- Observability --------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# ---------------------------- Rate Limiting -------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=1m

# ---------------------------- Tests ----------------------------------------
# Integration tests read TEST_DATABASE_URL and fall back to DATABASE_URL. Each
# test binary gets its own tripvault_test_<package> database inside that server,
# created on first use, so `make test` and `make run-api` can run at once.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripvault_test?sslmode=disable
TEST_REDIS_URL=redis://localhost:6379/1

# A scratch database whose name deliberately does not contain "test", used only
# by the test that proves the schema-drop guard refuses to run outside a test
# database. Nothing is ever written to it.
TESTDEV_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripvault_guard?sslmode=disable
